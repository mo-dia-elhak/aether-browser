<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/aether_bg" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <FrameLayout android:id="@+id/webContainer" android:layout_width="match_parent" android:layout_height="match_parent" />

            <ScrollView android:id="@+id/startPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp"
                        android:text="æther" android:fontFamily="serif" android:textStyle="italic" android:textSize="52sp" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Private by design." android:textSize="16sp" android:textColor="@color/aether_secondary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:layout_marginBottom="8dp"
                        android:text="FAVORITES" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="@color/aether_secondary" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/favGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" android:overScrollMode="never" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp"
                        android:background="@drawable/bg_card" android:gravity="center" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADS &amp; TRACKERS BLOCKED"
                            android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="@color/aether_secondary" />
                        <TextView android:id="@+id/statNumber" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="46sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:gravity="center" android:textSize="13sp" android:textColor="@color/aether_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp"
                android:max="100" android:progressTint="@color/aether_accent" android:visibility="gone" />
        </FrameLayout>

        <!-- Floating translucent "glass" capsule -->
        <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="10dp" android:elevation="8dp" android:orientation="vertical"
            android:background="@drawable/bg_bar" android:paddingTop="8dp" android:paddingBottom="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/btnEngine" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip" android:gravity="center" android:minWidth="34dp" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="@color/aether_accent" android:contentDescription="Search engine" />
                <EditText android:id="@+id/urlField" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="@null" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
                    android:singleLine="true" android:textSize="15sp" android:imeOptions="actionGo" android:inputType="textUri"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="@color/aether_secondary" />
                <TextView android:id="@+id/btnShield" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center"
                    android:drawableStart="@drawable/ic_shield" android:drawablePadding="3dp" android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:textSize="12sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Shields" android:visibility="gone" />
                <ImageButton android:id="@+id/btnReload" android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reload" android:contentDescription="Reload" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="Back" />
                <ImageButton android:id="@+id/btnForward" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_forward" android:contentDescription="Forward" />
                <ImageButton android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_share" android:contentDescription="Share" />
                <FrameLayout android:id="@+id/btnTabs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/tabCount" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                        android:background="@drawable/bg_tabcount" android:gravity="center" android:text="1" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                </FrameLayout>
                <ImageButton android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" android:contentDescription="Menu" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tab grid switcher -->
    <LinearLayout android:id="@+id/tabSwitcher" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/aether_bg" android:orientation="vertical" android:visibility="gone" android:clickable="true">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/tabGrid" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:padding="8dp" android:clipToPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_margin="10dp"
            android:background="@drawable/bg_bar" android:gravity="center_vertical" android:elevation="8dp">
            <TextView android:id="@+id/btnNewTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="+ New Tab" android:textSize="16sp" android:textColor="@color/aether_accent" android:background="?attr/selectableItemBackground" />
            <TextView android:id="@+id/btnDone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="Done" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/aether_accent" android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/fullscreen" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:visibility="gone" />
</FrameLayout>
